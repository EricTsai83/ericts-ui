{
  "name": "registry",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "postcss": {
    "plugins": [
      "@tailwindcss/postcss"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "skills:update": "pnpm dlx skills@latest update --project --yes",
    "build": "pnpm registry:build && pnpm display:check && next build",
    "start": "next start",
    "display:check": "node scripts/validate-registry-display.mjs && pnpm browse:check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "fumadocs-mdx source.config.ts .source && tsc --noEmit",
    "registry:build": "prettier --write registry registry.json --log-level warn && shadcn build",
    "test": "vitest run",
    "browse:check": "tsx --conditions=react-server scripts/validate-registry-browse.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "^16.17.8",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-ui": "^16.17.8",
    "hast-util-to-html": "^9.0.5",
    "lucide-react": "^1.63.0",
    "mermaid": "^12.2.0",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-grab": "^0.2.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": "24.x"
  }
}
