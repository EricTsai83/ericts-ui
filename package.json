{
  "name": "registry",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "postcss": {
    "plugins": [
      "@tailwindcss/postcss"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "skills:update": "pnpm dlx skills@latest update --project --yes",
    "build": "pnpm registry:build && next build",
