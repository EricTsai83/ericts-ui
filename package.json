    "display:check": "node scripts/validate-registry-display.mjs",
    "lint": "eslint .",
    "typecheck": "fumadocs-mdx source.config.ts .source && tsc --noEmit",
    "registry:build": "shadcn build",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
